# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code worktrees
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated agent handoffs may contain private conversation history.
*_CONTINUE_FROM_*.md

.vercel

# Claude Code worktrees (may contain API keys in settings.local.json)
.claude/worktrees/
.claude/settings.local.json
.claude/settings.local.json*

# Claude/Codex chat-continuation index (contains transcript summaries)
CODEX_CONTINUE_FROM_CLAUDE.md
